.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
runs/
data/cache/
# Real training data (FinTFM-R, D17): never enters git, same convention as trained weights.
data/edgar/
data/mortgage/
data/lendingclub/
# Every further real source lands under data/real/<source>/, so one rule covers sources that
# do not exist yet -- data/lendingclub/ was missing from this list for most of a session.
data/real/
*.pt
!tests/fixtures/*.pt

dist/
*.egg-info/

# never commit credentials
kaggle.json
.kaggle/
# Local env / secrets
.env
.env.*
# The negation must follow the pattern it exempts, or `.env.*` swallows it silently. That
# happened in finkele-axiom and was caught by `git check-ignore -v .env.example`, not by
# noticing the file had stopped being tracked.
!.env.example

