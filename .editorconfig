# Keeps whitespace consistent across editors, so a diff shows what changed rather than who
# opened the file.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 100

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.md]
indent_size = 2
# Markdown uses two trailing spaces for a hard line break; stripping them silently rewraps
# prose that was deliberately broken.
trim_trailing_whitespace = false
